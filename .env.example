# Telegram bot tokeni (@BotFather orqali olinadi)
BOT_TOKEN=
# Bot username'i (oxirida "bot" bo'lishi shart)
BOT_USERNAME=revilend_gamesbot
# Mini App manzili
MINI_APP_URL=https://revilend.games

# Admin panel va to'lov cheklarini tasdiqlash uchun Telegram user id
ADMIN_ID=123456789
# To'lov kartasi (Humo/Uzcard) endi `.env`dan emas, bazadagi `system_settings`
# jadvalidan olinadi: «👑 Admin panel» → «💳 Karta raqamini sozlash».
# Eski `.env` qiymatlari ishlatilmaydi, lekin zarar qilmaydi.

# Supabase (ixtiyoriy): bo'sh bo'lsa xonalar faqat xotirada saqlanadi
SUPABASE_URL=
SUPABASE_KEY=

# Mehmon rejimi faqat lokal sinov uchun kerak bo'lsa true qiling.
# Ishlab chiqarishda doimo false bo'lishi kerak.
ALLOW_GUEST_AUTH=false
# initData qancha soniya amal qiladi (standart 24 soat)
INIT_DATA_MAX_AGE=86400
